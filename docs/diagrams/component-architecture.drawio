        <mxCell id="title" value="&lt;b&gt;Audit Log Service — Component Architecture (modular monolith)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tb_service" value="Audit Log Service — single FastAPI process (application trust boundary)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
