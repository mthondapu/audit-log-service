        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API layer&lt;/b&gt; — routers, status codes, Location headers, OpenAPI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
