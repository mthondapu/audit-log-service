<mxfile host="app.diagrams.net" type="device">
  <diagram id="component-architecture" name="Component Architecture">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
