        </mxCell>
        <mxCell id="security" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;Bearer API key → principal; capability check before resource lookup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
