<mxfile host="app.diagrams.net" type="device">
  <diagram id="append-sequence" name="Audit Append and Integrity Sequence">
    <mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="960" math="0" shadow="0">
      <root>
