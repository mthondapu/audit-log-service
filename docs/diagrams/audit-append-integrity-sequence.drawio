        <mxCell id="n3" value="UNIQUE(sequence), UNIQUE(previous_hash), UNIQUE(id)&lt;br&gt;application role: no update/delete of immutable records" style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
