<mxfile host="app.diagrams.net" type="device">
  <diagram id="retention-redaction" name="Retention and Redaction">
    <mxGraphModel dx="1300" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1040" math="0" shadow="0">
      <root>
